# ============================================================================
# SkyPay Pilot MVP Comercial - Variables de Entorno para Vercel
# Solo necesitas estas 4 variables base al instalar a un cliente nuevo;
# todo lo demás (Skylink, Green/Evolution API, Resend, RIF, Nombre y Productos)
# se configura desde el panel web /admin y se guarda cifrado en Supabase.
# ============================================================================

# 1. Base de Datos Supabase (obligatorio en producción para persistencia real)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_TU_SUPABASE_SERVICE_ROLE_KEY

# 2. Seguridad del Panel Administrativo (/admin) y cifrado de API Keys
ADMIN_PASSWORD=CAMBIAR_POR_CLAVE_SEGURA_DEL_CLIENTE
SETTINGS_ENCRYPTION_KEY=CAMBIAR_POR_FRASE_ALEATORIA_DE_32_CARACTERES

# ============================================================================
# (OPCIONALES como fallback inicial — también se pueden editar en /admin)
# ============================================================================
SKYLINK_BASE_URL=https://dev-axis-payment.valinkgroup.com
SKYLINK_COMMERCE_CODE=754947900700
SKYLINK_API_KEY=REEMPLAZAR_CON_LA_CLAVE_DEL_COMERCIO

# WhatsApp (green_api | evolution_api | disabled)
WHATSAPP_PROVIDER=green_api
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_HOST=https://api.green-api.com
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Resend API (Envío de Facturas PDF por Correo Electrónico)
RESEND_API_KEY=REEMPLAZAR_CON_TU_RESEND_API_KEY
RESEND_FROM_EMAIL=SkyPay <onboarding@resend.dev>
